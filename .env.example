# Signaling
PORT=4040

# CORS: * (default, LAN prototype) or a comma-separated origin list
CORS_ORIGIN=*

# ICE — comma-separated URLs. Leave TURN_USERNAME / TURN_CREDENTIAL empty for STUN-only / LAN host candidates.
STUN_URLS=stun:stun.relay.metered.ca:80
TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=
